# Servidor
PORT=3001
NODE_ENV=development

# Banco de Dados PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=praxeo_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_DIALECT=postgres

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:3000

# Upload de Arquivos
UPLOAD_MAX_SIZE=5242880
UPLOAD_PATH=./uploads
